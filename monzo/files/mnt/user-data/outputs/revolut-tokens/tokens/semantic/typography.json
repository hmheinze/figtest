{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/schemas/token.json",
  "$metadata": {
    "source": "Revolut Brand System — Semantic Typography Tokens",
    "version": "1.0.0",
    "notes": "Semantic type scale maps role-based names to primitive font tokens. All text styles are combinations of family, size, weight, line-height and letter-spacing. WCAG 1.4.4 compliance: all text scales correctly up to 200% zoom. Body base: 16px. Components consume these tokens — not raw values."
  },
  "semantic": {
    "typography": {
      "display": {
        "hero": {
          "fontFamily":     { "$value": "{font.family.brand}", "$type": "fontFamily" },
          "fontSize":       { "$value": "{font.size.7xl}",     "$type": "dimension", "$description": "72px — marketing hero only" },
          "fontWeight":     { "$value": "{font.weight.bold}",  "$type": "fontWeight" },
          "lineHeight":     { "$value": "{font.lineHeight.tight}", "$type": "number" },
          "letterSpacing":  { "$value": "{font.letterSpacing.tighter}", "$type": "dimension" }
        },
        "large": {
          "fontFamily":     { "$value": "{font.family.brand}", "$type": "fontFamily" },
          "fontSize":       { "$value": "{font.size.6xl}",     "$type": "dimension", "$description": "60px" },
          "fontWeight":     { "$value": "{font.weight.bold}",  "$type": "fontWeight" },
          "lineHeight":     { "$value": "{font.lineHeight.tight}", "$type": "number" },
          "letterSpacing":  { "$value": "{font.letterSpacing.tighter}", "$type": "dimension" }
        },
        "medium": {
          "fontFamily":     { "$value": "{font.family.brand}", "$type": "fontFamily" },
          "fontSize":       { "$value": "{font.size.5xl}",     "$type": "dimension", "$description": "48px" },
          "fontWeight":     { "$value": "{font.weight.bold}",  "$type": "fontWeight" },
          "lineHeight":     { "$value": "{font.lineHeight.tight}", "$type": "number" },
          "letterSpacing":  { "$value": "{font.letterSpacing.tight}", "$type": "dimension" }
        }
      },
      "heading": {
        "h1": {
          "fontFamily":    { "$value": "{font.family.brand}",  "$type": "fontFamily" },
          "fontSize":      { "$value": "{font.size.4xl}",      "$type": "dimension", "$description": "36px" },
          "fontWeight":    { "$value": "{font.weight.bold}",   "$type": "fontWeight" },
          "lineHeight":    { "$value": "{font.lineHeight.tight}", "$type": "number" },
          "letterSpacing": { "$value": "{font.letterSpacing.tight}", "$type": "dimension" }
        },
        "h2": {
          "fontFamily":    { "$value": "{font.family.brand}",  "$type": "fontFamily" },
          "fontSize":      { "$value": "{font.size.3xl}",      "$type": "dimension", "$description": "30px" },
          "fontWeight":    { "$value": "{font.weight.bold}",   "$type": "fontWeight" },
