        "backgroundHover":{ "$value": "rgba(187,133,255,0.14)" },
        "border":         { "$value": "1px solid rgba(187,133,255,0.3)" },
        "borderHover":    { "$value": "1px solid rgba(187,133,255,0.55)" },
        "text":           { "$value": "{color.brand.purple.300}" },
        "borderRadius":   { "$value": "{borderRadius.full}" },
