{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/schemas/token.json",
  "$metadata": {
    "source": "Revolut Brand System — Component Tokens",
    "version": "1.0.0",
    "notes": "Component-level tokens reference semantic tokens only — never primitives directly. This creates a three-tier architecture: Primitive → Semantic → Component. Each component token describes a specific property of a specific component variant. These map 1:1 to Tailwind config values and React component props."
  },
  "component": {
    "button": {
      "$description": "Revolut button variants. All meet WCAG 1.4.3 (contrast), 2.4.7 (focus visible), 2.5.5 (target size).",
      "primary": {
        "background":       { "$value": "{semantic.color.brand.primary}",      "$type": "color" },
        "backgroundHover":  { "$value": "{semantic.color.brand.primaryHover}",  "$type": "color" },
        "backgroundActive": { "$value": "{semantic.color.brand.primaryActive}", "$type": "color" },
        "text":             { "$value": "{color.neutral.0}",                    "$type": "color" },
        "borderRadius":     { "$value": "{borderRadius.full}",                  "$type": "dimension" },
        "paddingX":         { "$value": "{semantic.spacing.component.paddingLg}", "$type": "dimension" },
        "paddingY":         { "$value": "{semantic.spacing.component.paddingMd}", "$type": "dimension" },
        "height":           { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" },
        "fontSize":         { "$value": "{font.size.md}",                       "$type": "dimension" },
        "fontWeight":       { "$value": "{font.weight.semibold}",               "$type": "fontWeight" },
        "focusRing":        { "$value": "{shadow.blue-glow}",                   "$type": "shadow" }
      },
      "secondary": {
        "background":       { "$value": "transparent",                          "$type": "color" },
        "backgroundHover":  { "$value": "{semantic.color.brand.primarySubtle}", "$type": "color" },
        "border":           { "$value": "{semantic.color.border.brand}",        "$type": "color" },
        "borderWidth":      { "$value": "{borderWidth.thin}",                   "$type": "dimension" },
        "text":             { "$value": "{semantic.color.brand.primary}",       "$type": "color" },
        "borderRadius":     { "$value": "{borderRadius.full}",                  "$type": "dimension" },
        "paddingX":         { "$value": "{semantic.spacing.component.paddingLg}", "$type": "dimension" },
        "paddingY":         { "$value": "{semantic.spacing.component.paddingMd}", "$type": "dimension" },
        "height":           { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" },
        "fontSize":         { "$value": "{font.size.md}",                       "$type": "dimension" },
        "fontWeight":       { "$value": "{font.weight.semibold}",               "$type": "fontWeight" }
      },
      "ghost": {
        "background":      { "$value": "transparent",                           "$type": "color" },
        "backgroundHover": { "$value": "{semantic.color.background.subtle}",    "$type": "color" },
        "text":            { "$value": "{semantic.color.text.primary}",         "$type": "color" },
        "borderRadius":    { "$value": "{borderRadius.full}",                   "$type": "dimension" },
        "height":          { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" }
      },
      "danger": {
        "background":      { "$value": "{semantic.color.background.danger}",    "$type": "color" },
        "text":            { "$value": "{color.neutral.0}",                     "$type": "color" },
        "borderRadius":    { "$value": "{borderRadius.full}",                   "$type": "dimension" },
        "height":          { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" }
      },
      "size": {
        "sm": { "height": { "$value": "{semantic.spacing.interactive.touchTargetMin}", "$type": "dimension" }, "fontSize": { "$value": "{font.size.sm}", "$type": "dimension" } },
        "md": { "height": { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" }, "fontSize": { "$value": "{font.size.md}", "$type": "dimension" } },
        "lg": { "height": { "$value": "56px", "$type": "dimension" }, "fontSize": { "$value": "{font.size.lg}", "$type": "dimension" } }
      }
    },
    "input": {
      "$description": "Text inputs, selects, and form fields.",
      "background":        { "$value": "{semantic.color.background.surface}",  "$type": "color" },
      "backgroundFocus":   { "$value": "{semantic.color.background.surface}",  "$type": "color" },
      "text":              { "$value": "{semantic.color.text.primary}",         "$type": "color" },
      "placeholder":       { "$value": "{semantic.color.text.tertiary}",        "$type": "color" },
      "border":            { "$value": "{semantic.color.border.default}",       "$type": "color" },
      "borderFocus":       { "$value": "{semantic.color.border.focus}",         "$type": "color" },
      "borderError":       { "$value": "{semantic.color.border.danger}",        "$type": "color" },
      "borderWidth":       { "$value": "{borderWidth.thin}",                   "$type": "dimension" },
      "borderWidthFocus":  { "$value": "{borderWidth.thick}",                  "$type": "dimension" },
      "borderRadius":      { "$value": "{borderRadius.lg}",                    "$type": "dimension" },
      "paddingX":          { "$value": "{semantic.spacing.component.paddingMd}", "$type": "dimension" },
      "paddingY":          { "$value": "{semantic.spacing.component.paddingSm}", "$type": "dimension" },
      "height":            { "$value": "{semantic.spacing.interactive.touchTargetIdeal}", "$type": "dimension" },
      "fontSize":          { "$value": "{font.size.md}",                       "$type": "dimension" },
      "labelSize":         { "$value": "{font.size.sm}",                       "$type": "dimension" },
      "labelWeight":       { "$value": "{font.weight.medium}",                 "$type": "fontWeight" },
      "helperSize":        { "$value": "{font.size.xs}",                       "$type": "dimension" },
      "focusRing":         { "$value": "{shadow.blue-glow}",                   "$type": "shadow" },
      "disabled": {
        "background":      { "$value": "{semantic.color.background.subtle}",   "$type": "color" },
        "text":            { "$value": "{semantic.color.text.disabled}",        "$type": "color" },
        "border":          { "$value": "{semantic.color.border.disabled}",      "$type": "color" }
      }
    },
    "card": {
      "$description": "Standard card component — transaction rows, product cards, info panels.",
      "background":    { "$value": "{semantic.color.background.surface}",  "$type": "color" },
      "border":        { "$value": "{semantic.color.border.default}",      "$type": "color" },
      "borderWidth":   { "$value": "{borderWidth.thin}",                  "$type": "dimension" },
      "borderRadius":  { "$value": "{borderRadius.xl}",                   "$type": "dimension" },
      "padding":       { "$value": "{semantic.spacing.component.paddingLg}", "$type": "dimension" },
      "shadow":        { "$value": "{shadow.sm}",                         "$type": "shadow" },
      "shadowHover":   { "$value": "{shadow.md}",                         "$type": "shadow" },
      "premium": {
        "background":  { "$value": "{semantic.color.background.premium}", "$type": "color" },
        "shadow":      { "$value": "{shadow.card-premium}",               "$type": "shadow" },
        "borderRadius":{ "$value": "{borderRadius.3xl}",                  "$type": "dimension" }
      }
    },
    "badge": {
      "$description": "Status badges — transaction status, notification counts, plan labels.",
      "borderRadius":  { "$value": "{borderRadius.full}",   "$type": "dimension" },
      "paddingX":      { "$value": "{semantic.spacing.component.paddingXs}", "$type": "dimension" },
      "paddingY":      { "$value": "2px",                   "$type": "dimension" },
      "fontSize":      { "$value": "{font.size.xs}",        "$type": "dimension" },
      "fontWeight":    { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
      "variants": {
        "default":  { "background": { "$value": "{semantic.color.background.subtle}",        "$type": "color" }, "text": { "$value": "{semantic.color.text.secondary}",    "$type": "color" } },
        "brand":    { "background": { "$value": "{semantic.color.brand.primarySubtle}",      "$type": "color" }, "text": { "$value": "{semantic.color.brand.primary}",      "$type": "color" } },
        "success":  { "background": { "$value": "{semantic.color.background.successSubtle}", "$type": "color" }, "text": { "$value": "{semantic.color.text.success}",       "$type": "color" } },
        "warning":  { "background": { "$value": "{semantic.color.background.warningSubtle}", "$type": "color" }, "text": { "$value": "{semantic.color.text.warning}",       "$type": "color" } },
        "danger":   { "background": { "$value": "{semantic.color.background.dangerSubtle}",  "$type": "color" }, "text": { "$value": "{semantic.color.text.danger}",        "$type": "color" } },
        "premium":  { "background": { "$value": "{semantic.color.background.premium}",       "$type": "color" }, "text": { "$value": "{color.neutral.0}",                   "$type": "color" } }
      }
    },
    "avatar": {
      "$description": "User/merchant avatars and icon containers.",
      "borderRadius":  { "$value": "{borderRadius.full}", "$type": "dimension" },
      "size": {
        "xs":  { "$value": "24px",  "$type": "dimension" },
        "sm":  { "$value": "32px",  "$type": "dimension" },
        "md":  { "$value": "40px",  "$type": "dimension" },
        "lg":  { "$value": "48px",  "$type": "dimension" },
        "xl":  { "$value": "64px",  "$type": "dimension" },
        "2xl": { "$value": "80px",  "$type": "dimension" }
      },
      "background":    { "$value": "{semantic.color.background.subtle}",    "$type": "color" },
      "text":          { "$value": "{semantic.color.text.secondary}",        "$type": "color" },
      "border":        { "$value": "{semantic.color.border.default}",        "$type": "color" }
    },
    "modal": {
      "background":    { "$value": "{semantic.color.background.surface}",  "$type": "color" },
      "borderRadius":  { "$value": "{borderRadius.2xl}",                   "$type": "dimension" },
      "padding":       { "$value": "{semantic.spacing.component.paddingXl}", "$type": "dimension" },
      "shadow":        { "$value": "{shadow.xl}",                          "$type": "shadow" },
      "scrim":         { "$value": "{semantic.color.background.scrim}",    "$type": "color" },
      "maxWidth":      { "$value": "480px",                                "$type": "dimension" }
    },
    "toast": {
      "$description": "Notification toasts / snackbars.",
      "background":    { "$value": "{semantic.color.background.inverse}",  "$type": "color" },
      "text":          { "$value": "{semantic.color.text.inverse}",         "$type": "color" },
      "borderRadius":  { "$value": "{borderRadius.xl}",                    "$type": "dimension" },
      "padding":       { "$value": "{semantic.spacing.component.paddingMd}", "$type": "dimension" },
      "shadow":        { "$value": "{shadow.lg}",                          "$type": "shadow" }
    },
    "navigation": {
      "$description": "Bottom tab bar (mobile) and top nav (web).",
      "height":        { "$value": "{semantic.spacing.layout.navHeight}",   "$type": "dimension" },
      "background":    { "$value": "{semantic.color.background.surface}",  "$type": "color" },
      "border":        { "$value": "{semantic.color.border.subtle}",        "$type": "color" },
      "iconActive":    { "$value": "{semantic.color.icon.brand}",           "$type": "color" },
      "iconInactive":  { "$value": "{semantic.color.icon.tertiary}",        "$type": "color" },
      "labelActive":   { "$value": "{semantic.color.brand.primary}",        "$type": "color" },
      "labelInactive": { "$value": "{semantic.color.text.tertiary}",        "$type": "color" },
      "labelSize":     { "$value": "{font.size.2xs}",                      "$type": "dimension" }
    }
  }
}
