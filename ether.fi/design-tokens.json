        "border":     { "$value": "1px solid rgba(74,222,128,0.25)" }
      },
      "warning": {
        "background": { "$value": "rgba(251,191,36,0.12)" },
        "text":       { "$value": "#FBBF24" },
        "border":     { "$value": "1px solid rgba(251,191,36,0.25)" }
      },
      "purple": {
        "background": { "$value": "rgba(187,133,255,0.12)" },
        "text":       { "$value": "#BB85FF" },
        "border":     { "$value": "1px solid rgba(187,133,255,0.25)" }
      },
      "neutral": {
        "background": { "$value": "rgba(255,255,255,0.07)" },
        "text":       { "$value": "{color.neutral.300}" },
        "border":     { "$value": "1px solid rgba(255,255,255,0.12)" }
      }
    },
    "tooltip": {
      "background":   { "$value": "{color.neutral.700}" },
      "text":         { "$value": "{color.neutral.100}" },
      "border":       { "$value": "1px solid rgba(255,255,255,0.12)" },
      "borderRadius": { "$value": "{borderRadius.md}" },
      "padding":      { "$value": "{spacing.2} {spacing.3}" },
      "shadow":        { "$value": "{shadow.lg}" }
    },
    "progressBar": {
      "track":       { "$value": "rgba(255,255,255,0.08)" },
      "fill":        { "$value": "linear-gradient(90deg, #BB85FF 0%, #5EEAD4 100%)" },
      "borderRadius":{ "$value": "{borderRadius.full}" },
      "height":      { "$value": "6px" }
    },
    "nav": {
      "background":       { "$value": "rgba(13,12,24,0.85)" },
      "backdropBlur":     { "$value": "blur(20px)" },
      "border":           { "$value": "1px solid rgba(255,255,255,0.07)" },
      "height":           { "$value": "64px" },
      "itemText":         { "$value": "{color.neutral.300}" },
      "itemTextHover":    { "$value": "{color.neutral.100}" },
      "itemTextActive":   { "$value": "{color.brand.purple.300}" }
    }
  }
}
