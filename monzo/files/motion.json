{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/schemas/token.json",
  "$metadata": {
    "source": "Revolut Brand System — Primitive Motion Tokens",
    "version": "1.0.0",
    "notes": "Motion tokens define the raw building blocks of animation — durations and easing curves. Semantic motion tokens reference these primitives. All durations respect prefers-reduced-motion at the component level."
  },
  "duration": {
    "instant":   { "$value": "0ms",   "$type": "duration", "$description": "No transition — disabled states, immediate feedback" },
    "fastest":   { "$value": "50ms",  "$type": "duration", "$description": "Micro feedback — button active press" },
    "faster":    { "$value": "100ms", "$type": "duration", "$description": "Quick state changes — icon swaps, toggle" },
    "fast":      { "$value": "150ms", "$type": "duration", "$description": "Hover states, tooltip appear" },
    "normal":    { "$value": "200ms", "$type": "duration", "$description": "Standard UI transitions" },
    "moderate":  { "$value": "250ms", "$type": "duration", "$description": "Card reveals, accordion expand" },
    "slow":      { "$value": "300ms", "$type": "duration", "$description": "Modal enter, drawer slide" },
    "slower":    { "$value": "400ms", "$type": "duration", "$description": "Page transitions, full-screen overlays" },
    "slowest":   { "$value": "500ms", "$type": "duration", "$description": "Onboarding reveals, celebration animations" },
    "deliberate":{ "$value": "700ms", "$type": "duration", "$description": "Complex choreographed sequences" }
  },
  "easing": {
    "linear":         { "$value": "linear",                        "$type": "cubicBezier", "$description": "Constant velocity — progress bars, loaders" },
    "ease":           { "$value": "ease",                          "$type": "cubicBezier", "$description": "Browser default ease" },
    "easeIn":         { "$value": "cubic-bezier(0.4, 0, 1, 1)",    "$type": "cubicBezier", "$description": "Accelerate — elements leaving the screen" },
    "easeOut":        { "$value": "cubic-bezier(0, 0, 0.2, 1)",    "$type": "cubicBezier", "$description": "Decelerate — elements entering the screen" },
    "easeInOut":      { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",  "$type": "cubicBezier", "$description": "Standard — transitions between states" },
    "spring":         { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Overshoot spring — friendly UI (toggles, success states)" },
    "anticipate":     { "$value": "cubic-bezier(0.36, 0, 0.66, -0.56)", "$type": "cubicBezier", "$description": "Pull-back before action — use very sparingly" },
    "smoothOut":      { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Exponential ease-out — sheet appears, card flip" }
  }
}
