      "easeOut":       { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "easeInOut":     { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "spring":        { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Springy for interactive feedback" },
      "expressive":    { "$value": "cubic-bezier(0.2, 1.4, 0.6, 1)", "$type": "cubicBezier", "$description": "More expressive spring for rewards animations" }
    }
  },

  "breakpoint": {
    "xs":  { "$value": "375px",  "$type": "dimension", "$description": "Small mobile" },
    "sm":  { "$value": "640px",  "$type": "dimension", "$description": "Large mobile" },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Tablet" },
