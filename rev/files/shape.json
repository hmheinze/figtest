{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/schemas/token.json",
  "$metadata": {
    "source": "Revolut Brand System — Primitive Shape Tokens",
    "version": "1.0.0",
    "notes": "Revolut uses a rounded, modern shape language. Radius values follow a consistent scale. Shadows are layered to convey elevation, not just depth — matching Revolut's premium material aesthetic."
  },
  "borderRadius": {
    "none":   { "$value": "0px",    "$type": "dimension" },
    "xs":     { "$value": "2px",    "$type": "dimension", "$description": "Hairline rounding — inline badges" },
    "sm":     { "$value": "4px",    "$type": "dimension", "$description": "Subtle rounding — tags, chips" },
    "md":     { "$value": "8px",    "$type": "dimension", "$description": "Input fields, small cards" },
    "lg":     { "$value": "12px",   "$type": "dimension", "$description": "Standard cards" },
    "xl":     { "$value": "16px",   "$type": "dimension", "$description": "Large cards, modals" },
    "2xl":    { "$value": "20px",   "$type": "dimension", "$description": "Prominent panels, drawers" },
    "3xl":    { "$value": "24px",   "$type": "dimension", "$description": "Hero card — e.g. payment card" },
    "4xl":    { "$value": "32px",   "$type": "dimension", "$description": "Bottom sheets, full-card overlays" },
    "full":   { "$value": "9999px", "$type": "dimension", "$description": "Pills — buttons, tags, avatars" }
  },
  "borderWidth": {
    "none":  { "$value": "0px",  "$type": "dimension" },
    "thin":  { "$value": "1px",  "$type": "dimension", "$description": "Standard border — inputs, cards, dividers" },
    "base":  { "$value": "1.5px","$type": "dimension", "$description": "Focus ring inner line" },
    "thick": { "$value": "2px",  "$type": "dimension", "$description": "Focus ring — WCAG 2.4.11 compliant (min 2px, 3:1 contrast)" },
    "heavy": { "$value": "3px",  "$type": "dimension", "$description": "Emphasis borders — selected state, active list items" }
  },
  "shadow": {
    "none": {
      "$value": "none",
      "$type": "shadow",
      "$description": "Flat / no elevation"
    },
    "xs": {
      "$value": "0px 1px 2px rgba(0,0,0,0.06), 0px 1px 3px rgba(0,0,0,0.10)",
      "$type": "shadow",
      "$description": "Elevation 1 — inline chips, tooltips"
    },
    "sm": {
      "$value": "0px 1px 3px rgba(0,0,0,0.08), 0px 4px 6px rgba(0,0,0,0.06)",
      "$type": "shadow",
      "$description": "Elevation 2 — input fields on focus, small cards"
    },
    "md": {
      "$value": "0px 4px 6px rgba(0,0,0,0.07), 0px 10px 15px rgba(0,0,0,0.10)",
      "$type": "shadow",
      "$description": "Elevation 3 — standard cards, dropdowns"
    },
    "lg": {
      "$value": "0px 10px 15px rgba(0,0,0,0.08), 0px 20px 25px rgba(0,0,0,0.10)",
      "$type": "shadow",
      "$description": "Elevation 4 — modals, bottom sheets"
    },
    "xl": {
      "$value": "0px 20px 25px rgba(0,0,0,0.10), 0px 40px 50px rgba(0,0,0,0.12)",
      "$type": "shadow",
      "$description": "Elevation 5 — drawers, command palettes"
    },
    "2xl": {
      "$value": "0px 25px 50px rgba(0,0,0,0.25)",
      "$type": "shadow",
      "$description": "Elevation 6 — floating panels"
    },
    "blue-glow": {
      "$value": "0px 0px 0px 3px rgba(127,132,246,0.35)",
      "$type": "shadow",
      "$description": "Revolut brand glow — focus ring for primary interactive elements"
    },
    "card-premium": {
      "$value": "0px 8px 24px rgba(110,76,229,0.20), 0px 2px 6px rgba(0,0,0,0.12)",
      "$type": "shadow",
      "$description": "Premium card glow — Metal and Ultra tier"
    }
  },
  "opacity": {
    "0":   { "$value": "0",    "$type": "number" },
    "5":   { "$value": "0.05", "$type": "number" },
    "10":  { "$value": "0.10", "$type": "number" },
    "20":  { "$value": "0.20", "$type": "number" },
    "25":  { "$value": "0.25", "$type": "number" },
    "40":  { "$value": "0.40", "$type": "number" },
    "50":  { "$value": "0.50", "$type": "number" },
    "60":  { "$value": "0.60", "$type": "number" },
    "75":  { "$value": "0.75", "$type": "number" },
    "80":  { "$value": "0.80", "$type": "number" },
    "90":  { "$value": "0.90", "$type": "number" },
    "100": { "$value": "1",    "$type": "number" }
  }
}
