    {
      "name": "Semantic Tokens",
      "description": "Purpose-based tokens that map to Primitives. Use these in all components.",
      "modes": [
        {
          "name": "Default",
          "variables": [

            { "name": "background/page",         "type": "COLOR", "value": { "r": 1,      "g": 1,      "b": 1,      "a": 1 },
              "description": "Main page background. #FFFFFF — clean white canvas matching Prada's luxury editorial aesthetic." },

            { "name": "background/surface",      "type": "COLOR", "value": { "r": 0.9569, "g": 0.9608, "b": 0.9686, "a": 1 },
              "description": "Card and panel backgrounds. #F4F5F7 — subtle off-white lift used on product cards and filter panels." },

            { "name": "background/overlay",      "type": "COLOR", "value": { "r": 0,      "g": 0,      "b": 0,      "a": 0.5 },
              "description": "Modal/drawer scrim. #000000 @ 50% opacity — darkens content behind overlays and drawers." },

            { "name": "text/primary",            "type": "COLOR", "value": { "r": 0,      "g": 0,      "b": 0,      "a": 1 },
              "description": "Headings, product names, body text. #000000 — primary text on white backgrounds." },

            { "name": "text/secondary",          "type": "COLOR", "value": { "r": 0.2,    "g": 0.2,    "b": 0.2,    "a": 1 },
              "description": "Subheadings, descriptors. #333333 — slightly softened dark used for secondary copy." },

            { "name": "text/tertiary",           "type": "COLOR", "value": { "r": 0.2706, "g": 0.2667, "b": 0.2157, "a": 1 },
              "description": "Meta labels, helper text, timestamps. #454437 — warm dark olive used for de-emphasised content." },

            { "name": "text/placeholder",        "type": "COLOR", "value": { "r": 0.4118, "g": 0.4118, "b": 0.4118, "a": 1 },
              "description": "Input placeholders, disabled labels. #696969 — mid-grey for reduced-emphasis text." },

            { "name": "text/disabled",           "type": "COLOR", "value": { "r": 0.7373, "g": 0.7373, "b": 0.7412, "a": 1 },
              "description": "Disabled state text. #BCBCBD — low contrast, clearly inactive." },

            { "name": "text/on-dark",            "type": "COLOR", "value": { "r": 1,      "g": 1,      "b": 1,      "a": 1 },
              "description": "Text rendered on dark/black surfaces (e.g. footer, dark banners). #FFFFFF." },

            { "name": "border/default",          "type": "COLOR", "value": { "r": 0.8784, "g": 0.8784, "b": 0.8784, "a": 1 },
