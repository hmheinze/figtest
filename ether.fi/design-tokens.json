    "md": {
      "$value": "0 8px 24px rgba(0,0,0,0.55), 0 4px 12px rgba(0,0,0,0.35)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 16px 40px rgba(0,0,0,0.6), 0 8px 20px rgba(0,0,0,0.4)",
