        "$value": "radial-gradient(ellipse 60% 40% at 50% 0%, rgba(187,133,255,0.18) 0%, transparent 70%)",
        "$type": "color"
      },
      "cardSurface": {
        "$value": "linear-gradient(145deg, rgba(37,36,56,0.9) 0%, rgba(20,19,31,0.9) 100%)",
        "$type": "color"
      },
      "primaryButton": {
        "$value": "linear-gradient(135deg, #BB85FF 0%, #7B40D4 100%)",
        "$type": "color"
      },
      "weETH": {
        "$value": "linear-gradient(135deg, #BB85FF 0%, #5E28B0 100%)",
        "$type": "color"
      },
      "eBTC": {
        "$value": "linear-gradient(135deg, #F7931A 0%, #C2620A 100%)",
        "$type": "color"
      },
      "eUSD": {
        "$value": "linear-gradient(135deg, #5EEAD4 0%, #0D9488 100%)",
        "$type": "color"
      }
