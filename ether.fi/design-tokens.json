      "display":  { "$value": "'Crimson Pro', 'Georgia', serif", "$type": "fontFamily", "$description": "Headlines, hero copy, editorial text" },
      "body":     { "$value": "'DM Sans', -apple-system, 'Helvetica Neue', sans-serif", "$type": "fontFamily", "$description": "All UI text, labels, body copy" },
      "mono":     { "$value": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace", "$type": "fontFamily", "$description": "Addresses, tx hashes, numeric data" }
    },
    "fontSize": {
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "15px", "$type": "dimension" },
      "md":   { "$value": "16px", "$type": "dimension" },
      "lg":   { "$value": "18px", "$type": "dimension" },
      "xl":   { "$value": "20px", "$type": "dimension" },
      "2xl":  { "$value": "24px", "$type": "dimension" },
      "3xl":  { "$value": "30px", "$type": "dimension" },
      "4xl":  { "$value": "36px", "$type": "dimension" },
      "5xl":  { "$value": "48px", "$type": "dimension" },
      "6xl":  { "$value": "60px", "$type": "dimension" },
      "7xl":  { "$value": "72px", "$type": "dimension" }
    },
    "lineHeight": {
      "none":    { "$value": "1",    "$type": "number" },
      "tight":   { "$value": "1.15", "$type": "number" },
      "snug":    { "$value": "1.3",  "$type": "number" },
