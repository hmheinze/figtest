{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/schemas/token.json",
  "$metadata": {
    "source": "Revolut Brand System — Primitive Spacing Tokens",
    "version": "1.0.0",
    "notes": "4px base grid. All spacing values are multiples of 4. This scale underpins layout, component padding, gap, margin and inset tokens. Compatible with Tailwind's default spacing scale convention."
  },
  "spacing": {
    "0":   { "$value": "0px",   "$type": "dimension", "$description": "No spacing" },
    "px":  { "$value": "1px",   "$type": "dimension", "$description": "1px hairline — borders and dividers only" },
    "0.5": { "$value": "2px",   "$type": "dimension", "$description": "2px — micro nudges" },
    "1":   { "$value": "4px",   "$type": "dimension", "$description": "4px — base grid unit" },
    "1.5": { "$value": "6px",   "$type": "dimension", "$description": "6px" },
    "2":   { "$value": "8px",   "$type": "dimension", "$description": "8px — compact inner padding" },
    "2.5": { "$value": "10px",  "$type": "dimension", "$description": "10px" },
    "3":   { "$value": "12px",  "$type": "dimension", "$description": "12px — default icon padding" },
    "3.5": { "$value": "14px",  "$type": "dimension", "$description": "14px" },
    "4":   { "$value": "16px",  "$type": "dimension", "$description": "16px — standard component padding (body text rhythm)" },
    "5":   { "$value": "20px",  "$type": "dimension", "$description": "20px" },
    "6":   { "$value": "24px",  "$type": "dimension", "$description": "24px — section gap default" },
    "7":   { "$value": "28px",  "$type": "dimension", "$description": "28px" },
    "8":   { "$value": "32px",  "$type": "dimension", "$description": "32px — card padding" },
    "9":   { "$value": "36px",  "$type": "dimension", "$description": "36px" },
    "10":  { "$value": "40px",  "$type": "dimension", "$description": "40px — large component padding" },
    "11":  { "$value": "44px",  "$type": "dimension", "$description": "44px — minimum touch target height (WCAG 2.5.5)" },
    "12":  { "$value": "48px",  "$type": "dimension", "$description": "48px — preferred touch target / nav bar height" },
    "14":  { "$value": "56px",  "$type": "dimension", "$description": "56px" },
    "16":  { "$value": "64px",  "$type": "dimension", "$description": "64px — section divider spacing" },
    "20":  { "$value": "80px",  "$type": "dimension", "$description": "80px" },
    "24":  { "$value": "96px",  "$type": "dimension", "$description": "96px — hero section vertical padding" },
    "28":  { "$value": "112px", "$type": "dimension", "$description": "112px" },
    "32":  { "$value": "128px", "$type": "dimension", "$description": "128px" },
    "36":  { "$value": "144px", "$type": "dimension", "$description": "144px" },
    "40":  { "$value": "160px", "$type": "dimension", "$description": "160px" },
    "48":  { "$value": "192px", "$type": "dimension", "$description": "192px" },
    "56":  { "$value": "224px", "$type": "dimension", "$description": "224px" },
    "64":  { "$value": "256px", "$type": "dimension", "$description": "256px — max content block constraint" }
  }
}
